    },
    "down": {
      "cls": "header-container lightImage header-container--has-scrolled-down header-container--has-scrolled-up",
      "position": "fixed",
      "height": "64px",
      "transform": "matrix(1, 0, 0, 1, 0, -64)",
      "top": "0px",
      "background": "linear-gradient(45deg, rgb(29, 68, 119) 22%, rgb(0, 161, 159))"
    },
    "up": {
      "cls": "header-container lightImage header-container--has-scrolled-up",
      "position": "fixed",
      "height": "64px",
      "transform": "matrix(1, 0, 0, 1, 0, 0)",
